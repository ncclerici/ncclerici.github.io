<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nicolò Clerici</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      background: #ffffff;
      color: #000000;
      line-height: 1.6;
      padding: 60px 40px;
      font-weight: 400;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    .bio {
      font-size: 12px;
      line-height: 1.6;
      font-weight: 400;
    }

    .text-line {
      margin-bottom: 16px;
    }

    .name {
      text-decoration: underline;
      margin-right: 4px;
    }

    a {
      color: #000000;
      text-decoration: underline;
      transition: opacity 0.3s;
      margin-left: 0;
      display: inline;
    }

    a:hover {
      opacity: 0.6;
    }

    @media (max-width: 768px) {
      body {
        padding: 40px 24px;
      }

      .bio {
        font-size: 11px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="bio">
      <div class="text-line">
        <span class="name">Nicolò Clerici</span>is a visual artist and multidisciplinary creative based in Milan. Working across photography, video, and visual storytelling.
      </div>
      <div class="text-line">
        <a href="https://www.instagram.com/ncclerici" target="_blank">@ncclerici</a>
      </div>
    </div>
  </div>
</body>
</html>
